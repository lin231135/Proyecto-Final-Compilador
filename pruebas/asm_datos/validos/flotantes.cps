// @caso: aritmetica de double y formato de impresion
// @salida: 0.3 | 0.333333 | 10.0 | -1.5 | 1000000.5 | 0.5 | 1.5 | true | 0.0 | 3000000000.0 | 2.0 | false
print(0.1 + 0.2);
print(1.0 / 3.0);
print(2.5 * 4.0);
print(-1.5);
print(1000000.5);
print(1 / 2.0);
print(7.5 % 2.0);
print(1.5 < 2);
print(0.0000001);
print(3000000000.0);
let x: float = 1;
x = x + 1;
print(x);
print(x != 2);
